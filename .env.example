NODE_ENV=development
PORT=3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=inmobiliaria
DB_SSL=false
# Solo desarrollo: TypeORM crea/actualiza tablas automáticamente
DB_SYNCHRONIZE=true
# Nunca activar en producción: borra y recrea el schema
DB_DROP_SCHEMA=false
# Seed automático al arrancar si la DB está vacía (false para desactivar)
DB_SEED=true

# JWT — generar con: openssl rand -base64 64
JWT_ACCESS_SECRET=cambiar-access-secret-minimo-32-caracteres-aleatorios
JWT_REFRESH_SECRET=cambiar-refresh-secret-distinto-del-access
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=inmobiliaria-api
JWT_AUDIENCE=inmobiliaria-web

# Pepper opcional añadido al password antes de Argon2
PASSWORD_PEPPER=

# API key privada para permitir POST /auth/register
REGISTER_API_KEY=cambiar-register-api-key-minimo-32-caracteres

# Cookies del refresh token (httpOnly)
REFRESH_COOKIE_NAME=refresh_token
COOKIE_SECURE=false
COOKIE_SAME_SITE=strict
# COOKIE_DOMAIN=.tudominio.com

# CORS — URL del frontend
CORS_ORIGIN=http://localhost:3001

# Si true, exige is_verified=true para login
REQUIRE_EMAIL_VERIFIED=false
