    "name": "API Inmobiliaria",
    "description": "Coleccion para probar la API NestJS de Inmobiliaria. Editar `baseUrl` si el backend no corre en localhost:3000. Login/Register/Refresh guardan automaticamente `accessToken` como variable de coleccion.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": []
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": []
      }
    }
  ],
